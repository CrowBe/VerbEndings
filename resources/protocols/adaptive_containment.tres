[gd_resource type="Resource" script_class="ExperimentProtocol" load_steps=2 format=3]

[ext_resource path="res://scripts/resources/ExperimentProtocol.gd" type="Script" id="1"]

[resource]
script = ExtResource("1")
protocol_id = &"adaptive_containment"
display_name = "Adaptive Containment"
objective = "Contain the released Creatures while maintaining Stability."
hazards = Array[String](["Creature swarm", "Escalating pressure"])
scoring_rules = {"placement": "weighted_survival", "placement_sharing": "verb_chain", "shared_bonus_events": ["swarm_kill"], "shared_reward_synergy": true, "survival_tick": 3, "swarm_kill": 8}
completion_condition = "The Experiment timer expires."
duration_seconds = 180.0
completion_mode = "TIMER"
classification = "PVE"
