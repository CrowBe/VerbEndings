# Feature: diagnostics (features/diagnostics.md)
wait_screen main_menu 15
wait_text "BUILD mvp-playtest.1" 5
shot 01-main-menu
key F8
wait_text "SESSION DIAGNOSTICS" 5
expect_text '"trial_seed": 20260812'
click "COPY SUMMARY"
wait_text "Summary copied." 5
snapshot 02-diagnostics-open
shot 02-diagnostics-open
click "CLOSE"
expect_absent "SESSION DIAGNOSTICS"
shot 03-diagnostics-closed
copy_user latest_session_summary.json
quit
